{
  "name": "bandy-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run lint:design-guard && npm run lint:design-adherence && npm run lint:content-contract && npm run lint:facility-consequences && npm run lint:o12-choice-preview",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "lint:design-guard": "node scripts/ds-guard.mjs",
    "lint:design-adherence": "node scripts/design-adherence.mjs",
    "lint:text-guard": "node scripts/text-guard-lint.mjs",
    "lint:content-contract": "node_modules/.bin/vite-node scripts/content-contract-guard.ts",
    "lint:facility-consequences": "node_modules/.bin/vite-node scripts/facility-consequence-guard.ts",
    "lint:o12-choice-preview": "node_modules/.bin/vite-node scripts/o12-choice-preview-guard.ts",
    "lint:duplicate-functions": "node_modules/.bin/vite-node scripts/find-duplicate-functions.ts --check",
    "mirror:generate": "node scripts/generate-color-mirror.mjs",
    "mirror:check": "node scripts/generate-color-mirror.mjs --check",
    "audit:scenes": "node scripts/capture-scenes.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test tests/visual/scenes.visual.ts tests/visual/baseline.visual.ts --update-snapshots",
    "stress": "node_modules/.bin/vite-node scripts/stress-test.ts",
    "analyze-stress": "node_modules/.bin/vite-node scripts/analyze-stress.ts",
    "analyze:choice-entropy": "node_modules/.bin/vite-node scripts/analyze-choice-entropy.ts",
    "analyze:firing-frequency": "node_modules/.bin/vite-node scripts/analyze-firing-frequency.ts",
    "analyze:text-repetition": "node_modules/.bin/vite-node scripts/analyze-text-repetition.ts",
    "analyze:c2-position-tactics": "node_modules/.bin/vite-node scripts/c2-position-tactic-measurement.ts",
    "analyze:c2-season-tactics": "node_modules/.bin/vite-node scripts/c2-season-tactic-measurement.ts",
    "calibrate:firing": "node_modules/.bin/vite-node scripts/h4-alla-tolv-avskedsfrekvens.ts",
    "calibrate:firing:sharded": "node scripts/run-firing-calibration-sharded.mjs",
    "calibrate:firing:verify": "node_modules/.bin/vite-node scripts/verify-firing-calibration.ts",
    "calibrate:firing:formal": "node scripts/run-firing-calibration-sharded.mjs --seeds=10000 --seasons=6 --seed-start=90000 --shard-size=20 --workers=8 --assert-targets",
    "warehouse:generate": "node_modules/.bin/vite-node scripts/data-warehouse/generate.ts",
    "warehouse:validate": "node_modules/.bin/vite-node scripts/data-warehouse/validate.ts",
    "check:deploy-sync": "node scripts/check-deploy-sync.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.9.0",
    "jsdom": "^29.0.1",
    "pg-mem": "^3.0.14",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "web-push": "^3.6.7",
    "zustand": "^5.0.12"
  }
}
