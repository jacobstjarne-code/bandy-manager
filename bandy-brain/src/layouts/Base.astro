---
import { editorialStatusLabel, findings } from '../data/findings';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Datadriven bandyanalys från verkliga matchdata och Bandy Manager-simuleringar.', noindex = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const findingMatch = Astro.url.pathname.match(/\/findings\/(\d{3})\/?$/);
const pageFinding = findingMatch ? findings.find((finding) => finding.num === findingMatch[1]) : undefined;

const editorialDescriptions = {
  core: 'En prioriterad analys som bär Bandy-Brains huvuderbjudande. Den väntar fortfarande på extern bandygranskning.',
  support: 'En relevant fördjupning med tydliga begränsningar. Den är stöd till kärnan, inte en fristående huvudslutsats.',
  open_thread: 'Den här analysen pekar ut en intressant fråga, men underlaget räcker ännu inte för en säker slutsats.',
  superseded: 'En senare analys ger ett bättre eller mer komplett svar. Sidan ligger kvar som en öppen del av historiken.',
  manager_lab: 'Detta är främst en teknisk analys av Bandy Managers simuleringsmotor, snarare än ett fynd om sporten.',
};
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Bandy-Brain</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <div class="poc-banner">Preliminär version · enbart proof of concept · inga slutsatser är verifierade</div>
    <header class="site-header">
      <div class="site-header__inner">
        <a href={`${base}/`} class="site-header__logo">
          <img src={`${base}/logo.svg`} alt="" width="28" height="28" class="site-header__logo-img" />
          Bandy-Brain
        </a>
        <nav>
          <ul class="site-header__nav">
            <li><a href={`${base}/findings/`} aria-current={Astro.url.pathname.startsWith(`${base}/findings`) ? 'page' : undefined}>Findings</a></li>
            <li><a href={`${base}/about/`} aria-current={Astro.url.pathname === `${base}/about/` ? 'page' : undefined}>Om</a></li>
            <li><a href={`${base}/review/`} aria-current={Astro.url.pathname === `${base}/review/` ? 'page' : undefined}>Granska</a></li>
            <li><a href={`${base}/ask/`} class="site-header__nav-cta">Ställ en fråga</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      {pageFinding && (
        <div class="editorial-notices" aria-label="Redaktionell bedömning">
          <div class={`editorial-notice editorial-notice--${pageFinding.editorial_status}`}>
            <p class="editorial-notice__label">
              {pageFinding.editorial_status === 'open_thread'
                ? 'Öppna spår — intressanta men ännu inte belagda'
                : editorialStatusLabel(pageFinding.editorial_status)}
            </p>
            <p>{editorialDescriptions[pageFinding.editorial_status]}</p>
            {pageFinding.editorial_status === 'superseded' && pageFinding.canonical_finding && (
              <a href={`${base}/findings/${pageFinding.canonical_finding}/`}>
                Läs den nyare analysen: finding {pageFinding.canonical_finding} →
              </a>
            )}
          </div>
          {pageFinding.correction_required && (
            <div class="editorial-notice editorial-notice--correction" role="alert">
              <p class="editorial-notice__label">Korrigering krävs</p>
              <p>Analysen innehåller ett känt sak- eller beräkningsfel och ska inte användas som underlag i nuvarande form.</p>
            </div>
          )}
        </div>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      Bandy-Brain — insikter ur verkliga matchdata och Bandy Manager-simuleringar.
      Datan är offentlig, metoden är öppen, begränsningarna erkänns.
      <span class="site-footer__links">
        <a href={`${base}/bandy/`}>Källor om bandy</a>
        ·
        <a href={`${base}/spelet/`}>Om spelet</a>
        ·
        <a href={`${base}/questions/`}>Öppna frågor</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .poc-banner {
    background: #c08a2e;
    color: #10233f;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.4rem 1rem;
    font-weight: 600;
  }
</style>
