---
import Base from '../../layouts/Base.astro';
import { findings, statusBadge } from '../../data/findings';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Findings">
  <div class="page-container">
    <h1 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
      Findings
    </h1>
    <p style="max-width: 620px; color: var(--color-muted); font-size: 0.95rem; margin-bottom: 1.5rem; font-family: var(--font-ui); line-height: 1.6;">
      Bandy Brain är en skiss på vad som händer när man systematiskt letar mönster
      i bandydata. Varje finding är en hypotes som datan väckt — byggd på verklig
      matchdata från Bandygrytan och Bandy Managers simuleringsmotor.
    </p>
    <p style="max-width: 620px; color: var(--color-muted); font-size: 0.95rem; margin-bottom: 2.5rem; font-family: var(--font-ui); line-height: 1.6;">
      Inget här är verifierat mot bandykunskap ännu, och det är själva poängen:
      findingarna är råmaterial för en bandykunnig att bedöma — vilka är värda att
      gräva i, vilka är brus, vilka säger något vi inte visste? Se det som ett
      proof of concept och en idéväckare, inte som färdiga slutsatser. När en nyare
      analys ersätter en äldre — ofta för att metoden förbättrats — markeras det.
      Att findings revideras är inte en svaghet i ansatsen, det är hur den ska fungera.
    </p>

    <div class="filter-bar" id="filter-bar">
      <button class="filter-btn is-active" data-filter="all">Alla</button>
      <button class="filter-btn" data-filter="verified" disabled title="Inga findings är verifierade ännu">Verifierade</button>
    </div>

    <ul class="findings-list" id="findings-list">
      {findings.map(f => (
        <li>
          <div class="finding-card" data-verified={f.verified_by ? 'true' : 'false'} data-status={f.status}>
            <p class="finding-card__number">
              Finding {f.num} · {f.date}
              {statusBadge(f.status) && (
                <span class={`finding-badge finding-badge--${f.status}`}>
                  {statusBadge(f.status)}{f.superseded_by ? ` av ${f.superseded_by}` : ''}
                </span>
              )}
            </p>
            <h2 class="finding-card__title">
              <a href={`${base}/findings/${f.num}/`}>{f.title}</a>
            </h2>
            {f.verified_by && (
              <p class="finding-card__excerpt">
                Verifierad av {f.verified_by}
              </p>
            )}
            {!f.verified_by && f.excerpt && (
              <p class="finding-card__excerpt">{f.excerpt}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>

  <script>
    const bar = document.getElementById('filter-bar');
    const list = document.getElementById('findings-list');
    if (bar && list) {
      const btns = bar.querySelectorAll<HTMLButtonElement>('.filter-btn:not(:disabled)');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const filter = btn.dataset.filter;
          list.querySelectorAll<HTMLLIElement>('li').forEach(li => {
            const card = li.querySelector('.finding-card');
            if (filter === 'all') {
              li.style.display = '';
            } else {
              li.style.display = card?.dataset.verified === 'true' ? '' : 'none';
            }
          });
        });
      });
    }
  </script>
</Base>
