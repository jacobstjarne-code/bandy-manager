---
import Base from '../../layouts/Base.astro';
import { editorialStatusLabel, findings } from '../../data/findings';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Findings">
  <div class="page-container">
    <h1 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
      Findings
    </h1>
    <p style="max-width: 620px; color: var(--color-muted); font-size: 0.95rem; margin-bottom: 1.5rem; font-family: var(--font-ui); line-height: 1.6;">
      Bandy Brain är en skiss på vad som händer när man systematiskt letar mönster
      i bandydata. Varje finding är en hypotes som datan väckt — byggd på verklig
      matchdata från Bandygrytan och Bandy Managers simuleringsmotor.
    </p>
    <p style="max-width: 620px; color: var(--color-muted); font-size: 0.95rem; margin-bottom: 2.5rem; font-family: var(--font-ui); line-height: 1.6;">
      Inget här är verifierat mot bandykunskap ännu. Därför skiljer vi mellan kärna,
      stöd, öppna spår, ersatta analyser och tekniska motorstudier. Öppna spår är
      intressanta frågor som ännu inte är belagda — de ligger kvar för att historiken
      och möjligheterna ska vara synliga. Kända sakfel märks separat med
      ”Korrigering krävs”. Se sajten som ett proof of concept och en idéväckare,
      inte som färdiga slutsatser.
    </p>

    <div class="filter-bar" id="filter-bar">
      <button class="filter-btn is-active" data-filter="all">Alla</button>
      <button class="filter-btn" data-filter="core">Kärna</button>
      <button class="filter-btn" data-filter="support">Stöd</button>
      <button class="filter-btn" data-filter="open_thread">Öppna spår</button>
      <button class="filter-btn" data-filter="superseded">Ersatta</button>
      <button class="filter-btn" data-filter="manager_lab">Bandy Manager Lab</button>
    </div>

    <ul class="findings-list" id="findings-list">
      {findings.map(f => (
        <li>
          <div class="finding-card" data-editorial-status={f.editorial_status}>
            <p class="finding-card__number">
              Finding {f.num} · {f.date}
              <span class={`finding-badge finding-badge--${f.editorial_status}`}>
                {editorialStatusLabel(f.editorial_status)}
                {f.canonical_finding ? ` av ${f.canonical_finding}` : ''}
              </span>
              {f.correction_required && (
                <span class="finding-badge finding-badge--correction">Korrigering krävs</span>
              )}
            </p>
            <h2 class="finding-card__title">
              <a href={`${base}/findings/${f.num}/`}>{f.title}</a>
            </h2>
            {f.verified_by && (
              <p class="finding-card__excerpt">
                Verifierad av {f.verified_by}
              </p>
            )}
            {!f.verified_by && f.excerpt && (
              <p class="finding-card__excerpt">{f.excerpt}</p>
            )}
            {f.editorial_status === 'open_thread' && !f.excerpt && (
              <p class="finding-card__excerpt">Intressant fråga, men underlaget räcker ännu inte för en säker slutsats.</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>

  <script>
    const bar = document.getElementById('filter-bar');
    const list = document.getElementById('findings-list');
    if (bar && list) {
      const btns = bar.querySelectorAll<HTMLButtonElement>('.filter-btn:not(:disabled)');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const filter = btn.dataset.filter;
          list.querySelectorAll<HTMLLIElement>('li').forEach(li => {
            const card = li.querySelector('.finding-card');
            li.style.display = filter === 'all' || card?.dataset.editorialStatus === filter ? '' : 'none';
          });
        });
      });
    }
  </script>
</Base>
