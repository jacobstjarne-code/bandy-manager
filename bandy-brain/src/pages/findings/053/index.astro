          <tr><td>Hammarby IF – Sandvikens AIK/BK</td><td>6</td><td>5,17</td><td>[3,2 – 7,3]</td></tr>
          <tr><td>Bollnäs GOIF BF – Edsbyns IF</td><td>8</td><td>5,12</td><td>[3,4 – 7,1]</td></tr>
          <tr><td>AIK Bandy – IK Sirius</td><td>6</td><td>5,0</td><td>[3,3 – 6,5]</td></tr>
          <tr><td>Bollnäs GIF – Sandvikens AIK/BK</td><td>8</td><td>5,0</td><td>[3,6 – 6,1]</td></tr>
        </tbody>
      </table>

      <p><strong>Top 10 kallaste matchups:</strong></p>
      <table>
        <thead><tr><th>Matchup</th><th>n</th><th>Fouls/match</th></tr></thead>
