        <tbody>
          <tr><td>IK Sirius – Villa-Lidköping BK</td><td>IK Sirius hemma: 0,0 %</td><td>Villa borta: 100 %</td><td>100 pp</td></tr>
          <tr><td>IFK Motala – Villa-Lidköping BK</td><td>IFK Motala hemma: 0,0 %</td><td>Villa borta: 83 %</td><td>83 pp</td></tr>
