          <tr><td>AIK Bandy – Hammarby IF</td><td>6</td><td>5,83</td><td>[3,8 – 8,2]</td></tr>
          <tr><td>Broberg/Söderhamn – IFK Vänersborg</td><td>12</td><td>5,75</td><td>[4,6 – 7,0]</td></tr>
          <tr><td>Gripen Trollhättan BK – Hammarby IF</td><td>6</td><td>5,67</td><td>[3,7 – 8,0]</td></tr>
          <tr><td>Gripen Trollhättan BK – Sandvikens AIK/BK</td><td>9</td><td>5,33</td><td>[4,1 – 6,6]</td></tr>
          <tr><td>Broberg/Söderhamn – Gripen Trollhättan BK</td><td>6</td><td>5,17</td><td>[4,5 – 5,8]</td></tr>
          <tr><td>AIK Bandy – IK Sirius</td><td>6</td><td>5,0</td><td>[3,3 – 6,5]</td></tr>
        </tbody>
      </table>

      <p><strong>Top 10 kallaste matchups:</strong></p>
      <table>
        <thead><tr><th>Matchup</th><th>n</th><th>Fouls/match</th></tr></thead>
        <tbody>
          <tr><td>IFK Motala – Villa-Lidköping BK</td><td>11</td><td>1,82</td></tr>
          <tr><td>Broberg/Söderhamn – Villa-Lidköping BK</td><td>12</td><td>1,83</td></tr>
          <tr><td>AIK Bandy – Frillesås BK</td><td>6</td><td>2,0</td></tr>
          <tr><td>Frillesås BK – Villa-Lidköping BK</td><td>12</td><td>2,25</td></tr>
          <tr><td>IFK Motala – Västerås SK</td><td>8</td><td>2,38</td></tr>
          <tr><td>Hammarby IF – Villa-Lidköping BK</td><td>12</td><td>2,42</td></tr>
          <tr><td>Edsbyns IF – Hammarby IF</td><td>12</td><td>2,42</td></tr>
          <tr><td>Frillesås BK – Hammarby IF</td><td>12</td><td>2,5</td></tr>
          <tr><td>IK Sirius – Villa-Lidköping BK</td><td>18</td><td>2,5</td></tr>
          <tr><td>Frillesås BK – Västerås SK</td><td>12</td><td>2,5</td></tr>
        </tbody>
      </table>

      <p><strong>Top 5 mest målrika matchups:</strong></p>
      <table>
        <thead><tr><th>Matchup</th><th>n</th><th>Mål/match</th></tr></thead>
        <tbody>
          <tr><td>IK Sirius – Åby/Tjureda IF</td><td>6</td><td>12,67</td></tr>
          <tr><td>Hammarby IF – Sandvikens AIK/BK</td><td>6</td><td>12,67</td></tr>
          <tr><td>AIK Bandy – Vetlanda BK</td><td>6</td><td>12,5</td></tr>
          <tr><td>Hammarby Bandy – Vetlanda BK</td><td>6</td><td>12,33</td></tr>
