---
import Base from '../layouts/Base.astro';
import { loadFacts } from '../lib/facts';
import { latestFinding } from '../data/findings';

const facts = loadFacts();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const statsCount = facts.filter(f => f.category === 'stats').length;
const rulesCount = facts.filter(f => f.category === 'rules').length;
const latest = latestFinding;
---

<Base title="Bandy-Brain">
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__kicker">Datadriven bandyanalys</p>
      <h1 class="hero__title">Mönster i verklig bandydata — och i tusentals simulerade matcher</h1>
      <p class="hero__body">
        Bandy Brain letar systematiskt efter mönster i Elitseriens verkliga
        matchdata från Bandygrytan — comeback-fönster, domarreformer,
        matchtemperatur, spelstil. Där verklig data tar slut kompletterar
        Bandy Managers simuleringsmotor, som kan köra tusentals matcher på ett
        dygn. Inget är verifierat mot bandykunskap ännu; se det som en
        idégenerator, inte färdiga slutsatser.
      </p>
      <a href={`${base}/findings/`} class="hero__cta">Läs findings →</a>
    </div>
  </section>

  <div class="page-container">
    <div style="max-width: 720px">

      <section style="margin-bottom: 3rem">
        <h2 style="font-family: var(--font-ui); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 1.5rem; font-weight: 700;">
          Senaste finding
        </h2>

        <div class="finding-card">
          <p class="finding-card__number">Finding {latest.num} · {latest.date}</p>
          <h3 class="finding-card__title">
            <a href={`${base}/findings/${latest.num}/`}>{latest.title}</a>
          </h3>
          {latest.excerpt && (
            <p class="finding-card__excerpt">{latest.excerpt}</p>
          )}
          <p style="margin-top: 1rem; font-family: var(--font-ui); font-size: 0.85rem;">
            <a href={`${base}/findings/${latest.num}/`}>Läs finding →</a>
          </p>
        </div>
      </section>

      <section>
        <h2 style="font-family: var(--font-ui); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 1rem; font-weight: 700;">
          Kunskapsbasen
        </h2>
        <p style="font-family: var(--font-ui); font-size: 0.9rem; color: var(--color-muted); line-height: 1.6;">
          Findings bygger på {facts.length} strukturerade facts — {rulesCount} regler ur SvBF:s regelbok
          och {statsCount} statistiska parametrar kalibrerade mot Bandygrytans matchdatabas (2019–2026).
        </p>
        <p style="font-family: var(--font-ui); font-size: 0.85rem; margin-top: 0.75rem;">
          <a href={`${base}/bandy/`}>Källor om bandy →</a>
          <span style="margin: 0 0.5rem; color: var(--color-muted);">·</span>
          <a href={`${base}/spelet/`}>Om spelet →</a>
        </p>
      </section>

    </div>
  </div>
</Base>
