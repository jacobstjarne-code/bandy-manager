---
import Base from '../layouts/Base.astro';
import { loadFacts } from '../lib/facts';
import { editorialStatusLabel, latestFinding, findings } from '../data/findings';

const facts = loadFacts();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const statsCount = facts.filter(f => f.category === 'stats').length;
const rulesCount = facts.filter(f => f.category === 'rules').length;
const latest = latestFinding;

// Kuraterad ingång för nya läsare — den redaktionellt prioriterade kärnan.
const startHere = [
  { num: '002', why: 'Drygt vart femte mål kommer ur hörnläge — med korrekt åtskilda mått för andel och konvertering.' },
  { num: '051', why: 'Comebackandelen är tydligt förhöjd för tidiga reduceringar i andra halvlek.' },
  { num: '052', why: 'Den registrerade utvisningsfrekvensen ökade 16 % säsongen 2025-26.' },
  { num: '055', why: 'Nästan hela ökningen bestod av femminutare, medan tiominutarna låg still.' },
  { num: '056', why: 'Dam och herr har liknande mål- och utvisningsnivå men olika resultatstruktur.' },
  { num: '057', why: 'Sabotagekategorin är vanligare bland utvisningar när laget leder.' },
  { num: '058', why: 'Nästan två av tre straffar blir mål, med en tydlig dam–herr-skillnad.' },
  { num: '061', why: 'Fyra av tio rena tiominutersöverlägen innehåller minst ett mål.' },
  { num: '062', why: 'Allsvenskan och Elitserien är mycket lika på flera matchmått, men utvisningarna skiljer.' },
  { num: '005', why: 'Grundmönstret: mål faller inte jämnt över en bandymatch.' },
].map(s => ({ ...s, f: findings.find(f => f.num === s.num) })).filter(s => s.f);
---

<Base title="Bandy-Brain">
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__kicker">Datadriven bandyanalys</p>
      <h1 class="hero__title">Vad 2 000 bandymatcher vet som vi inte visste</h1>
      <p class="hero__body">
        Bandy Brain letar systematiskt efter mönster i Elitseriens och
        Allsvenskans verkliga matchdata från Bandygrytan — när matcher avgörs,
        vad utvisningar kostar, hur domningen förändras över tid, vad som skiljer
        dam från herr. Där verklig data tar slut kompletterar Bandy Managers
        simuleringsmotor, som är kalibrerad mot samma matchdata. Varje finding
        redovisar metod, osäkerhet och begränsningar — och när vi haft fel
        står felet kvar, markerat och förklarat. Inget är ännu oberoende granskat av
        bandykunniga; se sajten som en idégenerator som söker sina första
        kritiska läsare, inte som färdiga slutsatser.
      </p>
      <a href={`${base}/findings/`} class="hero__cta">Läs findings →</a>
    </div>
  </section>

  <div class="page-container">
    <div style="max-width: 720px">

      <section style="margin-bottom: 3rem">
        <h2 style="font-family: var(--font-ui); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 1.5rem; font-weight: 700;">
          Börja här — tio findings som bär helheten
        </h2>
        <ol style="font-family: var(--font-ui); font-size: 0.92rem; line-height: 1.6; padding-left: 1.2rem; margin: 0;">
          {startHere.map(s => (
            <li style="margin-bottom: 0.9rem;">
              <a href={`${base}/findings/${s.num}/`} style="font-weight: 600;">{s.f.title}</a>
              <span style="color: var(--color-muted); display: block;">{s.why}</span>
            </li>
          ))}
        </ol>
      </section>

      <section style="margin-bottom: 3rem">
        <h2 style="font-family: var(--font-ui); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 1.5rem; font-weight: 700;">
          Senaste finding
        </h2>

        <div class="finding-card">
          <p class="finding-card__number">
            Finding {latest.num} · {latest.date}
            <span class={`finding-badge finding-badge--${latest.editorial_status}`}>
              {editorialStatusLabel(latest.editorial_status)}
            </span>
          </p>
          <h3 class="finding-card__title">
            <a href={`${base}/findings/${latest.num}/`}>{latest.title}</a>
          </h3>
          {latest.excerpt && (
            <p class="finding-card__excerpt">{latest.excerpt}</p>
          )}
          <p style="margin-top: 1rem; font-family: var(--font-ui); font-size: 0.85rem;">
            <a href={`${base}/findings/${latest.num}/`}>Läs finding →</a>
          </p>
        </div>
      </section>

      <section>
        <h2 style="font-family: var(--font-ui); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 1rem; font-weight: 700;">
          Kunskapsbasen
        </h2>
        <p style="font-family: var(--font-ui); font-size: 0.9rem; color: var(--color-muted); line-height: 1.6;">
          Findings bygger på {facts.length} strukturerade facts — {rulesCount} regler ur SvBF:s regelbok
          och {statsCount} statistiska parametrar kalibrerade mot Bandygrytans matchdatabas (2019–2026).
        </p>
        <p style="font-family: var(--font-ui); font-size: 0.85rem; margin-top: 0.75rem;">
          <a href={`${base}/bandy/`}>Källor om bandy →</a>
          <span style="margin: 0 0.5rem; color: var(--color-muted);">·</span>
          <a href={`${base}/spelet/`}>Om spelet →</a>
        </p>
      </section>

    </div>
  </div>
</Base>
