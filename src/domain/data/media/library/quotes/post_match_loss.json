  {
    "id": "quote_post_loss_022",
    "type": "quote",
    "tags": ["post_match_loss"],
    "attribution": { "name": "{coachName}", "role": "Tränare" },
    "body": "Vi höll inte våra positioner, {motståndare} utnyttjade det varje gång."
