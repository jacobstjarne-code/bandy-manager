  {
    "id": "quote_post_loss_019",
    "type": "quote",
    "tags": ["post_match_loss"],
    "attribution": { "name": "{coachName}", "role": "Tränare" },
    "body": "Vi fick stryk på mittfältet och resten av laget vek ner sig."
