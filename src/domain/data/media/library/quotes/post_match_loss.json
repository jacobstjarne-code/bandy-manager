  {
    "id": "quote_post_loss_014",
    "type": "quote",
    "tags": ["post_match_loss"],
    "attribution": { "name": "{coachName}", "role": "Tränare" },
    "body": "Två misstag på fel ställe, {motståndare} drog nytta av det."
