  {
    "id": "quote_post_win_021",
    "type": "quote",
    "tags": ["post_match_win"],
    "attribution": { "name": "{coachName}", "role": "Coach" },
    "body": "Vi gjorde inga tabbar och {motståndare} var inte tillräckligt skarpa."
